[Unit]
Description=VLESS+REALITY VPN server
After=network-online.target
Wants=network-online.target

[Service]
# config is root:600; systemd injects it read-only for the DynamicUser service
LoadCredential=server.json:/etc/vpn/server.json
ExecStart=/usr/local/bin/vpn-server -config %d/server.json
Restart=on-failure
RestartSec=5

# ephemeral user, binding 443 without root
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
